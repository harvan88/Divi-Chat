{
  "compilerOptions": {
    // 🚀 Configuración moderna
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",

    // 🧠 JSX sin React, usando KITA para generar HTML como string
    "jsx": "react-jsx",
    "jsxImportSource": "@kitajs/html",
    "plugins": [{ "name": "@kitajs/ts-html-plugin" }],
    "types": ["@kitajs/html/htmx.d.ts"],

    // 🛠️ Importaciones relativas más cómodas
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"]
    },

    // 🧱 Modo Bundler y ESM
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "noEmit": true,

    // ✅ Buenas prácticas
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // 🔧 Flexible para desarrollo
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "scripts/generate-preview-map.ts"],
  "exclude": ["node_modules", "dist", "build", "test", "**/*.spec.ts"]
}
